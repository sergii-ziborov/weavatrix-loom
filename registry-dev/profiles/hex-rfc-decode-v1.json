    "Suite must be recorded in evidence artifact before status=conformant"
  ],
  "expected_error_families": ["invalid-hex"],
  "vectors": [
    { "id": "empty", "input_b64": "", "expect_ok": true, "expect_output_b64": "" },
    { "id": "abc-hex", "input_b64": "NjE2MjYz", "expect_ok": true }
  ],
  "negative_vectors": [
    { "id": "odd", "input_b64": "YWJj", "expect_error_family": "invalid-hex" }
