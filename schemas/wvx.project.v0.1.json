{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weavatrix.com/schemas/wvx.project.v0.1.json",
  "title": "WVX Project Document v0.1",
  "description": "Wire format for a Weavatrix Loom project (.wvx.json). Authoritative runtime types live in crates/wvx-ir and crates/wvx-types; this schema is for tooling and Studio validation. Type tags accept snake_case wire forms (json_value) and dotted display aliases (json.value).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "wvx.project.v0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable project id (filesystem-safe preferred)."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": ["string", "null"],
      "description": "Instance id whose outputs are seeded by playground/export input."
    },
    "instances": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/instance" }
    },
    "bindings": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/binding" }
    },
    "capabilities": {
      "type": "array",
      "default": [],
      "description": "Embedded capability contracts for offline validation; may be hydrated from a registry.",
      "items": { "$ref": "#/$defs/capability" }
    },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "capabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "typeRef": {
      "description": "Canonical boundary type. Unit variants are strings; compounds are single-key objects (serde externally tagged, snake_case).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unit",
            "bool",
            "i64",
            "u64",
            "f64",
            "string",
            "bytes",
            "json_value",
            "json.value",
            "error_record",
            "error.record"
          ]
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": true
        },
        {
          "type": "string",
          "minLength": 1,
          "description": "Named / opaque type id (forward-compatible)."
        }
      ]
    },
    "portSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/typeRef" },
        "required": { "type": "boolean", "default": true }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "inputs", "outputs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portSpec" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portSpec" }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "effects": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "uiPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "description": "Non-semantic layout (ADR-0003)."
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "capability": { "$ref": "#/$defs/capabilityRef" },
        "implementation": {
          "type": ["string", "null"],
          "description": "Full implementation id (e.g. serde-json.parse-owned@1)."
        },
        "config": {
          "type": "object",
          "default": {}
        },
        "ui": {
          "oneOf": [
            { "$ref": "#/$defs/uiPosition" },
            { "type": "null" }
          ]
        }
      }
    },
    "portPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance", "port"],
      "properties": {
        "instance": { "type": "string", "minLength": 1 },
        "port": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/portPath" },
        "to": { "$ref": "#/$defs/portPath" }
      }
    }
  }
}
